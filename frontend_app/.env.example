# Frontend environment variables (example)
# Copy to your deployment environment configuration (do not commit real secrets).

# Base URL of the backend API (Express). This ensures UI calls like POST /review go to the backend,
# not to the frontend origin (which would cause 404s).
REACT_APP_API_BASE=https://your-backend-host:3001

# Alternatively, you may use:
# REACT_APP_BACKEND_URL=https://your-backend-host:3001
